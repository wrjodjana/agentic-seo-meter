{
  "description": "Logs documentation fetched by the agent for agentic-seo-meter",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^WebFetch$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/check_fetch.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^WebFetch$|^WebSearch$|^mcp__.*(fetch|scrape|crawl|search)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/log_fetch.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^WebFetch$|^WebSearch$|^mcp__.*(fetch|scrape|crawl|search)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/log_fetch.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
